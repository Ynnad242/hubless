# Maintainer: Hubless contributors
pkgname=hubless
pkgver=0.9.0
pkgrel=1
pkgdesc="Configure Logitech G mice on Linux: DPI, buttons, onboard profiles and SUPERSTRIKE HITS triggers"
arch=('any')
url="https://github.com/hubless-app/hubless"
license=('MIT')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'polkit')
makedepends=('python-build' 'python-installer' 'python-setuptools')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 data/70-hubless.rules "$pkgdir/usr/lib/udev/rules.d/70-hubless.rules"
  install -Dm644 data/io.github.hubless.Hubless.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 data/io.github.hubless.Hubless.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  install -Dm644 hubless/data/icons/io.github.hubless.Hubless.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
