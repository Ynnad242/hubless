{
  "name": "hubless",
  "productName": "Hubless",
  "version": "0.18.0",
  "homepage": "https://github.com/Ynnad242/hubless",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ynnad242/hubless.git"
  },
  "bugs": {
    "url": "https://github.com/Ynnad242/hubless/issues"
  },
  "description": "One app for your gaming mice, keyboards and headsets on Linux",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "node-hid@3.4.0": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "io.github.hubless.Hubless",
    "productName": "Hubless",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "category": "Settings",
      "icon": "build/icon.png",
      "synopsis": "Gaming mice, keyboards and headsets in one app",
      "desktop": {
        "entry": {
          "Keywords": "logitech;g hub;razer;synapse;wooting;mouse;keyboard;headset;dpi;"
        }
      },
      "syncDesktopName": true,
      "executableName": "hubless",
      "maintainer": "Hubless contributors"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false
    },
    "extraResources": [
      {
        "from": "data/70-hubless.rules",
        "to": "70-hubless.rules"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/hubless-update",
        "to": "hubless-update"
      },
      {
        "from": "build/io.github.hubless.update.policy",
        "to": "io.github.hubless.update.policy"
      },
      {
        "from": "data/devices",
        "to": "devices"
      },
      {
        "from": "PRIVACY.md",
        "to": "docs/PRIVACY.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "docs/THIRD_PARTY_NOTICES.md"
      }
    ],
    "deb": {
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh"
    },
    "rpm": {
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh"
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "libnotify",
        "mesa"
      ],
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh",
      "fpm": [
        "--after-upgrade",
        "build/after-install.sh"
      ]
    }
  },
  "desktopName": "io.github.hubless.Hubless.desktop",
  "author": {
    "name": "Hubless contributors"
  }
}
